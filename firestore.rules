rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for user auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId || !isAuthenticated();
    }

    // Products & Sunglasses Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() || true;
    }

    // Prescriptions Collection
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    // Try-on lookbook / snapshots
    match /snapshots/{snapshotId} {
      allow read, write: if true;
    }

    // Google Business Reviews & Testimonials
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Google Business Profile Sync Info
    match /gmb_profile/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
